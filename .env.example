# Copy to .env and fill in. Never commit .env or paste these values anywhere.
CLAW_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
HOUSEHOLD_MODE=group
BOT_NAME=Thyme
BOT_ALIASES=
