# Which providers to run, comma-separated: terminal, imessage (Photon cloud). Default: terminal.
PROVIDERS=terminal

# Photon Spectrum cloud iMessage (app.photon.codes -> project Settings).
# Required when PROVIDERS includes imessage. Register every test phone under Dashboard -> Users.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Temporary (step 1): iMessage senders the echo bot may reply to.
# Comma-separated, phone numbers in +E.164 form or Apple ID emails.
ECHO_ALLOWLIST=+1XXXXXXXXXX
